<section id="title_bar" style="background-image: url({{ section.settings.banner_bg | img_url: 'master' }})">
  <div class="page-width">
    <div class="title_text">
      {% if section.settings.main_title != blank %}
        <h1>{{ section.settings.main_title }}</h1>
      {% else %}
        <h1>{{ page.title | escape }}</h1>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Title Bar",
    "settings": [
      {
        "type": "image_picker",
        "id": "banner_bg",
        "label": "Banner Background"
      },
      {
        "type": "text",
        "id": "main_title",
        "label": "Main Title"
      }
    ],
    "presets": [
      {
        "name": "Title Bar"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
#title_bar {
    padding: 80px 0;
    background-repeat: no-repeat;
    background-size: cover;
    text-align: center;
}
#title_bar .title_text h1 {
    font-family: DejaVu Sans, sans-serif;
    color: #ffffff;
    font-size: 35px;
    line-height: 42px;
    font-weight: 700;
    margin: 0;
}
{% endstylesheet %}

