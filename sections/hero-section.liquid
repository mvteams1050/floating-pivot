<section class="custom-hero-section-top">
  <div class="page-width page-width-desktop">
  <div class="custom-hero-section-top__container ">
    {% if section.settings['hero-main-haeding'] != blank %}
      <h1 class="custom-hero-section__top-title">{{ section.settings['hero-main-haeding'] }}</h1>
    {% endif %}

    {% if section.settings['hero-main-description'] != blank %}
      <p class="custom-hero-section__top-description">{{ section.settings['hero-main-description'] }}</p>
    {% endif %}

    {% if section.settings['hero-main-top-button-link'] != blank %}
      <a class="custom-hero-section__top-button" href="{{ section.settings.hero-main-top-button-link }}">
        {{- section.settings['hero-main-top-button'] -}}
      </a>
    {% endif %}
  </div>
    </div>
</section>

<section class="custom-hero-section">
  <div class="custom-hero-section__container page-width page-width-desktop">
    <div class="custom-hero-section__column">
      {% if section.settings['hero-images'] != blank %}
        <img
          class="custom-hero-section__left-block--image"
          src="{{ section.settings.hero-images | img_url: 'large' }}"
          alt=""
        >
      {% endif %}
      <div class="hero-button">
      {% if section.settings.heading != blank %}
        <h3 class="custom-hero-section__left-block--title">{{ section.settings.heading }}</h3>
      {% endif %}

      {% if section.settings['button-url-1'] != blank %}
        
        <a class="custom-hero-section__left-block--button" href="{{ section.settings.button-url-1 }}">
          {{ section.settings['button-text-1'] }}
        </a>
       
      {% endif %}
       </div>
    </div>

    <div class="custom-hero-section__column">
      {% if section.settings['hero-images-2'] != blank %}
        <img
          class="custom-hero-section__left-block--image"
          src="{{ section.settings.hero-images-2 | img_url: 'large' }}"
          alt=""
        >
      {% endif %}
      <div class="custom-hero-section__right-column-text">
        {% if section.settings.heading_2 != blank %}
          <h3 class="custom-hero-section__left-block--title">{{ section.settings.heading_2 }}</h3>
        {% endif %}

        {% if section.settings['button-url-2'] != blank %}
          <a class="custom-hero-section__left-block--button" href="{{ section.settings.button-url-2 }}">
            {{ section.settings['button-text-1'] }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="custom-hero-section__column">
      {% if section.settings['hero-images-3'] != blank %}
        <img
          class="custom-hero-section__left-block--image"
          src="{{ section.settings.hero-images-3 | img_url: 'large' }}"
          alt=""
        >
      {% endif %}

      <div class="custom-hero-section__right-column-text">
        {% if section.settings.heading_3 != blank %}
          <h3 class="custom-hero-section__left-block--title">{{ section.settings.heading_3 }}</h3>
        {% endif %}

        {% if section.settings['button-url-3'] != blank %}
          <a class="custom-hero-section__left-block--button" href="{{ section.settings.button-url-3 }}">
            {{ section.settings['button-text-2'] }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

